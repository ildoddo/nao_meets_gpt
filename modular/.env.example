# NAO Conversational System - Environment Variables Template
# 
# ISTRUZIONI:
# 1. Copia questo file e rinominalo in ".env"
#    cp .env.example .env
# 
# 2. Sostituisci i valori "your_xxx_here" con le tue chiavi reali
# 
# 3. NON committare il file .env su Git!
#    (è già in .gitignore)
#

# ===== REQUIRED =====

# GitHub Models API Key (RICHIESTA)
# Ottienila da: https://github.com/settings/tokens
# Permessi necessari: read:packages
GITHUB_API_KEY=your_github_token_here


# ===== NAO CONFIGURATION =====

# URL del server body.py su NAO
# Sostituisci con l'IP del tuo robot NAO
NAO_SERVER_URL=http://192.168.151.121:5004


# ===== OPTIONAL API KEYS =====
# Decommenta e compila se usi questi servizi

# Groq API Key (opzionale, per Groq Whisper)
# GROQ_API_KEY=your_groq_key_here

# OpenAI API Key (opzionale, se usi OpenAI diretto)
# OPENAI_API_KEY=your_openai_key_here

# Anthropic API Key (opzionale, se usi Claude)
# ANTHROPIC_API_KEY=your_anthropic_key_here


# ===== OPTIONAL SETTINGS =====

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# File per salvare conversazioni
# CONVERSATION_FILE=conversation_context.txt
