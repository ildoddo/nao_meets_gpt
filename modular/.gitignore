# NAO Conversational System - .gitignore

# Environment variables (IMPORTANTE!)
.env
.env.local
.env.*.local

# API Keys e secrets
*.key
*.pem
secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# Audio files
*.wav
*.mp3
*.flac
input_raw.wav

# Conversation history
conversation_context.txt
*.txt.bak

# Whisper models cache
~/.cache/whisper/

# Jupyter Notebook
.ipynb_checkpoints

# Testing
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
*.temp
temp/
tmp/
